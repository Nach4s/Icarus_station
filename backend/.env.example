# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Security
SECRET_KEY=your-secret-key-here

# Configuration Paths
# Укажите полный путь к файлу конфигурации (например: D:\Project\config\mission_config.yaml)
CONFIG_PATH=/path/to/your/config/mission_config.yaml

# API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
